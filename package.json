{
  "name": "chokie-it-solutions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:backend",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "db:grant": "node scripts/grant-runtime.mjs",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "worker:once": "node --import tsx scripts/outbox-worker.ts --once",
    "worker:start": "node --import tsx scripts/outbox-worker.ts",
    "retention:preview": "node --import tsx scripts/retention.ts",
    "retention:apply": "node --import tsx scripts/retention.ts --apply",
    "test:backend": "node scripts/test-database.mjs && vitest run",
    "test:browser": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@better-auth/prisma-adapter": "^1.7.14",
    "@fontsource/manrope": "latest",
    "@hookform/resolvers": "latest",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "latest",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.14",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dotenv": "^18.0.9",
    "file-type": "^22.2.0",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "latest",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "prisma": "^7.10.1",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.21.1",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
