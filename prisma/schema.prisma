generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}

enum PublicationStatus {
 DRAFT
 PUBLISHED
 ARCHIVED
}

enum UserStatus {
 ACTIVE
 DISABLED
}

enum InquiryStatus {
 NEW
 IN_REVIEW
 CONTACTED
 RESOLVED
 ARCHIVED
}

enum ConsultationStatus {
 NEW
 CONTACTED
 SCHEDULED
 COMPLETED
 CANCELLED
}

enum TicketStatus {
 NEW
 OPEN
 IN_PROGRESS
 WAITING_FOR_CUSTOMER
 RESOLVED
 CLOSED
}

enum Priority {
 LOW
 NORMAL
 HIGH
 CRITICAL
}

enum Availability {
 UNKNOWN
 OPEN
 CLOSED
 COMING_SOON
}

enum Visibility {
 PUBLIC
 PRIVATE
}

enum MediaStatus {
 PENDING
 READY
 QUARANTINED
 DELETED
}

enum FeatureKind {
 FEATURE
 BENEFIT
}

enum OutboxStatus {
 PENDING
 PROCESSING
 SENT
 FAILED
}

model User {
 id String @id @default(uuid()) @db.Uuid
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 status UserStatus @default(ACTIVE)
 passwordChangeRequired Boolean @default(false)
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions Session[]
 accounts Account[]
 roles UserRole[]
 resets PasswordResetToken[]
 audits AuditLog[]
 services Service[]
 solutions Solution[]
 trainings TrainingProgram[]
 partners Partner[]
 clients Client[]
 testimonials Testimonial[]
 caseStudies CaseStudy[]
 pages Page[]
 settings WebsiteSetting[]
 media MediaAsset[]
 assignedInquiries ContactInquiry[]
 assignedConsultations ConsultationRequest[]
 assignedTraining TrainingInquiry[]
 tickets SupportTicket[]
 messages TicketMessage[]
 ticketHistory TicketStatusHistory[]
 notifications Notification[]
 notes InternalNote[]
 @@index([status,deletedAt])
}

model Role {
 id String @id @default(uuid()) @db.Uuid
 name String @unique
 description String
 users UserRole[]
 permissions RolePermission[]
}

model Permission {
 id String @id @default(uuid()) @db.Uuid
 key String @unique
 description String
 roles RolePermission[]
}

model UserRole {
 userId String @db.Uuid
 roleId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 role Role @relation(fields:[roleId],references:[id],onDelete:Restrict)
 @@id([userId,roleId])
 @@index([roleId])
}

model RolePermission {
 roleId String @db.Uuid
 permissionId String @db.Uuid
 role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
 permission Permission @relation(fields:[permissionId],references:[id],onDelete:Restrict)
 @@id([roleId,permissionId])
 @@index([permissionId])
}

model Session {
 id String @id @default(uuid()) @db.Uuid
 token String @unique
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,expiresAt])
}

model Account {
 id String @id @default(uuid()) @db.Uuid
 accountId String
 providerId String
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 accessToken String? @db.Text
 refreshToken String? @db.Text
 idToken String? @db.Text
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String? @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([providerId,accountId])
 @@index([userId])
}

model VerificationToken {
 id String @id @default(uuid()) @db.Uuid
 identifier String
 value String @db.Text
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([identifier])
}

model PasswordResetToken {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 tokenHash String @unique
 expiresAt DateTime
 consumedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId,expiresAt])
}

model AuditLog {
 id String @id @default(uuid()) @db.Uuid
 actorId String? @db.Uuid
 actor User? @relation(fields:[actorId],references:[id],onDelete:Restrict)
 action String
 resourceType String
 resourceId String?
 outcome String
 metadata Json @default("{}")
 createdAt DateTime @default(now())
 @@index([createdAt])
 @@index([actorId,createdAt])
 @@index([resourceType,resourceId])
}

model SeoMetadata {
 id String @id @default(uuid()) @db.Uuid
 title String @db.VarChar(60)
 description String @db.VarChar(160)
 canonicalUrl String?
 ogTitle String?
 ogDescription String?
 ogImageId String? @db.Uuid
 ogImage MediaAsset? @relation("SeoImage",fields:[ogImageId],references:[id],onDelete:Restrict)
 indexable Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 service Service?
 solution Solution?
 training TrainingProgram?
 page Page?
 caseStudy CaseStudy?
}

model ServiceFeature {
 id String @id @default(uuid()) @db.Uuid
 serviceId String @db.Uuid
 service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade)
 kind FeatureKind @default(FEATURE)
 text String
 displayOrder Int @default(0)
 @@index([serviceId,kind,displayOrder])
}

model ServiceRelation {
 serviceId String @db.Uuid
 relatedId String @db.Uuid
 service Service @relation("RelatedFrom",fields:[serviceId],references:[id],onDelete:Cascade)
 related Service @relation("RelatedTo",fields:[relatedId],references:[id],onDelete:Restrict)
 @@id([serviceId,relatedId])
 @@index([relatedId])
}

model SolutionService {
 solutionId String @db.Uuid
 serviceId String @db.Uuid
 solution Solution @relation(fields:[solutionId],references:[id],onDelete:Cascade)
 service Service @relation(fields:[serviceId],references:[id],onDelete:Restrict)
 @@id([solutionId,serviceId])
 @@index([serviceId])
}

model PageSection {
 id String @id @default(uuid()) @db.Uuid
 pageId String @db.Uuid
 page Page @relation(fields:[pageId],references:[id],onDelete:Cascade)
 key String
 type String
 heading String
 body String @db.Text
 visible Boolean @default(true)
 displayOrder Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([pageId,key])
 @@index([pageId,displayOrder])
}

model WebsiteSetting {
 id String @id @default(uuid()) @db.Uuid
 key String @unique
 value Json
 status PublicationStatus @default(DRAFT)
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
}

model MediaAsset {
 id String @id @default(uuid()) @db.Uuid
 objectKey String @unique
 bucket String
 originalName String
 mimeType String
 byteSize Int
 sha256 String
 visibility Visibility @default(PRIVATE)
 approvedAt DateTime?
 status MediaStatus @default(PENDING)
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ownerId String? @db.Uuid
 owner User? @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 serviceImages Service[] @relation("ServiceImage")
 solutionImages Solution[] @relation("SolutionImage")
 trainingImages TrainingProgram[] @relation("TrainingImage")
 partnerImages Partner[] @relation("PartnerImage")
 clientImages Client[] @relation("ClientImage")
 testimonialImages Testimonial[] @relation("TestimonialImage")
 caseImages CaseStudy[] @relation("CaseImage")
 pageImages Page[] @relation("PageImage")
 seoImages SeoMetadata[] @relation("SeoImage")
 attachments TicketAttachment[]
 @@index([visibility,status,deletedAt])
}

model TicketMessage {
 id String @id @default(uuid()) @db.Uuid
 ticketId String @db.Uuid
 ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 body String @db.Text
 internal Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([ticketId,createdAt])
}

model TicketAttachment {
 id String @id @default(uuid()) @db.Uuid
 ticketId String @db.Uuid
 ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
 mediaId String @unique @db.Uuid
 media MediaAsset @relation(fields:[mediaId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 @@index([ticketId])
}

model TicketStatusHistory {
 id String @id @default(uuid()) @db.Uuid
 ticketId String @db.Uuid
 ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Restrict)
 actorId String? @db.Uuid
 actor User? @relation(fields:[actorId],references:[id],onDelete:Restrict)
 fromStatus TicketStatus?
 toStatus TicketStatus
 createdAt DateTime @default(now())
 @@index([ticketId,createdAt])
}

model InternalNote {
 id String @id @default(uuid()) @db.Uuid
 authorId String @db.Uuid
 author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
 body String @db.Text
 inquiryId String? @db.Uuid
 inquiry ContactInquiry? @relation(fields:[inquiryId],references:[id],onDelete:Restrict)
 consultationId String? @db.Uuid
 consultation ConsultationRequest? @relation(fields:[consultationId],references:[id],onDelete:Restrict)
 trainingInquiryId String? @db.Uuid
 trainingInquiry TrainingInquiry? @relation(fields:[trainingInquiryId],references:[id],onDelete:Restrict)
 ticketId String? @db.Uuid
 ticket SupportTicket? @relation(fields:[ticketId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 @@index([inquiryId])
 @@index([consultationId])
 @@index([trainingInquiryId])
 @@index([ticketId])
}

model Notification {
 id String @id @default(uuid()) @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 type String
 title String
 resourceType String?
 resourceId String?
 readAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId,readAt,createdAt])
}

model EmailOutbox {
 id String @id @default(uuid()) @db.Uuid
 dedupeKey String @unique
 payload String @db.Text
 status OutboxStatus @default(PENDING)
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 leaseUntil DateTime?
 leaseToken String?
 lastError String?
 sentAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,nextAttemptAt])
}

model RateLimit {
 key String @id
 count Int
 expiresAt DateTime
 @@index([expiresAt])
}

model Service {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 shortDescription String
 description String @db.Text
 icon String?
 features ServiceFeature[]
 related ServiceRelation[] @relation("RelatedFrom")
 relatedTo ServiceRelation[] @relation("RelatedTo")
 solutions SolutionService[]
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("ServiceImage",fields:[imageId],references:[id],onDelete:Restrict)
 seoId String? @unique @db.Uuid
 seo SeoMetadata? @relation(fields:[seoId],references:[id],onDelete:Restrict)
 @@index([status,deletedAt,displayOrder])
}

model Solution {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 shortDescription String
 description String @db.Text
 services SolutionService[]
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("SolutionImage",fields:[imageId],references:[id],onDelete:Restrict)
 seoId String? @unique @db.Uuid
 seo SeoMetadata? @relation(fields:[seoId],references:[id],onDelete:Restrict)
 @@index([status,deletedAt,displayOrder])
}

model TrainingProgram {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 description String @db.Text
 learningObjectives String[] @default([])
 targetAudience String?
 duration String?
 deliveryMode String?
 availability Availability @default(UNKNOWN)
 startDate DateTime?
 registrationDeadline DateTime?
 inquiries TrainingInquiry[]
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("TrainingImage",fields:[imageId],references:[id],onDelete:Restrict)
 seoId String? @unique @db.Uuid
 seo SeoMetadata? @relation(fields:[seoId],references:[id],onDelete:Restrict)
 @@index([status,deletedAt,displayOrder])
}

model Partner {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 name String
 description String @db.Text
 website String?
 category String?
 verifiedAt DateTime?
 approvedAt DateTime?
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("PartnerImage",fields:[imageId],references:[id],onDelete:Restrict)
 
 @@index([status,deletedAt,displayOrder])
}

model Client {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 name String
 description String @db.Text
 industry String?
 website String?
 approvedAt DateTime?
 testimonials Testimonial[]
 caseStudies CaseStudy[]
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("ClientImage",fields:[imageId],references:[id],onDelete:Restrict)
 
 @@index([status,deletedAt,displayOrder])
}

model Testimonial {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 name String
 position String?
 organization String?
 quote String @db.Text
 approvedAt DateTime?
 featured Boolean @default(false)
 clientId String? @db.Uuid
 client Client? @relation(fields:[clientId],references:[id],onDelete:Restrict)
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("TestimonialImage",fields:[imageId],references:[id],onDelete:Restrict)
 
 @@index([status,deletedAt,displayOrder])
}

model CaseStudy {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 description String @db.Text
 approvedAt DateTime?
 clientId String? @db.Uuid
 client Client? @relation(fields:[clientId],references:[id],onDelete:Restrict)
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("CaseImage",fields:[imageId],references:[id],onDelete:Restrict)
 seoId String? @unique @db.Uuid
 seo SeoMetadata? @relation(fields:[seoId],references:[id],onDelete:Restrict)
 @@index([status,deletedAt,displayOrder])
}

model Page {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 title String
 sections PageSection[]
 status PublicationStatus @default(DRAFT)
 displayOrder Int @default(0)
 publishedAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 authorId String? @db.Uuid
 author User? @relation(fields:[authorId],references:[id],onDelete:Restrict)
 imageId String? @db.Uuid
 image MediaAsset? @relation("PageImage",fields:[imageId],references:[id],onDelete:Restrict)
 seoId String? @unique @db.Uuid
 seo SeoMetadata? @relation(fields:[seoId],references:[id],onDelete:Restrict)
 @@index([status,deletedAt,displayOrder])
}

model ContactInquiry {
 id String @id @default(uuid()) @db.Uuid
 reference String @unique
 fullName String
 email String
 phone String?
 organization String?
 serviceInterest String?
 subject String
 message String @db.Text
 consentAt DateTime
 status InquiryStatus @default(NEW)
 assignedToId String? @db.Uuid
 assignedTo User? @relation(fields:[assignedToId],references:[id],onDelete:Restrict)
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 notes InternalNote[]
 @@index([status,createdAt])
 @@index([assignedToId])
}

model ConsultationRequest {
 id String @id @default(uuid()) @db.Uuid
 reference String @unique
 fullName String
 email String
 phone String?
 organization String?
 requestedService String?
 projectDescription String @db.Text
 preferredContactDate DateTime?
 status ConsultationStatus @default(NEW)
 assignedToId String? @db.Uuid
 assignedTo User? @relation(fields:[assignedToId],references:[id],onDelete:Restrict)
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 notes InternalNote[]
 @@index([status,createdAt])
 @@index([assignedToId])
}

model TrainingInquiry {
 id String @id @default(uuid()) @db.Uuid
 reference String @unique
 fullName String
 email String
 phone String?
 organization String?
 programId String @db.Uuid
 program TrainingProgram @relation(fields:[programId],references:[id],onDelete:Restrict)
 message String @db.Text
 status InquiryStatus @default(NEW)
 @@index([programId])
 assignedToId String? @db.Uuid
 assignedTo User? @relation(fields:[assignedToId],references:[id],onDelete:Restrict)
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 notes InternalNote[]
 @@index([status,createdAt])
 @@index([assignedToId])
}

model SupportTicket {
 id String @id @default(uuid()) @db.Uuid
 reference String @unique
 fullName String
 email String
 phone String?
 
 serviceCategory String
 subject String
 description String @db.Text
 priority Priority @default(NORMAL)
 status TicketStatus @default(NEW)
 closedAt DateTime?
 messages TicketMessage[]
 attachments TicketAttachment[]
 history TicketStatusHistory[]
 assignedToId String? @db.Uuid
 assignedTo User? @relation(fields:[assignedToId],references:[id],onDelete:Restrict)
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 notes InternalNote[]
 @@index([status,createdAt])
 @@index([assignedToId])
}

